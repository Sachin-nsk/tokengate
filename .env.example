# Copy to .env (git-ignored). Only needed for live runs; CI and load tests use the fake upstream.
ANTHROPIC_API_KEY=
TOKENGATE_UPSTREAM_URL=https://api.anthropic.com
# Optional local upstream (ADR 0007)
TOKENGATE_OLLAMA_URL=http://localhost:11434
# Display currency for dashboards and reports (ADR 0008); storage stays USD
TOKENGATE_DISPLAY_CURRENCY=INR
